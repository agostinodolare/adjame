# Configuration Supabase
# Récupérez ces valeurs dans votre projet Supabase :
# https://app.supabase.com/project/[votre-projet]/settings/api

SUPABASE_URL=https://votre-projet-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_publique
SUPABASE_JWKS_URL=https://votre-projet-ref.supabase.co/auth/v1/.well-known/jwks.json

# Pour Vite (client-side)
VITE_SUPABASE_URL=https://votre-projet-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre_cle_publique

# Optionnel : ID du projet (trouvé dans Settings → General)
SUPABASE_PROJECT_ID=votre-projet-ref
VITE_SUPABASE_PROJECT_ID=votre-projet-ref

# Clé secrète (pour les opérations côté serveur) - À garder secrète !
# Ne jamais utiliser de clé sb_secret_ dans VITE_* ni la commiter.
SUPABASE_SECRET_KEY=
